# API 密钥配置示例
# 复制此文件为 .env 并填入你的真实 API Key
# .env 已在 .gitignore 中，不会被提交

# ============================================================
# LLM 端点（OpenAI 兼容协议，默认走阿里云 DashScope）
# ============================================================
# 申请：https://dashscope.console.aliyun.com/
OPENAI_API_KEY=sk-your-dashscope-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 推荐模型（按性价比排）：
#   qwen-turbo    — 最便宜、速度最快，CI 跑全量评测首选
#   qwen-plus     — 质量更好，本地手测 / 重要 PR 用
#   qwen-max      — 最强，只在排查具体 bad case 时用
OPENAI_MODEL=qwen-turbo

# DeepEval 的环境变量名是 OPENAI_MODEL_NAME，这里由 config.py 自动映射

# ============================================================
# Embedding 端点（可选）
# ============================================================
# 不填也能跑，会用本地 HuggingFace 中文模型（shibing624/text2vec-base-chinese）
# 已通过 HF 镜像（HF_ENDPOINT=https://hf-mirror.com）解决国内下载问题
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ============================================================
# 项目路径（一般不需要改）
# ============================================================
CHROMA_DB_PATH=./chroma_db
DOCS_DIR=./document
